# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# Never commit .env. Never paste these values in chat or screenshots.

# ---- LLMs (Gemini first, Groq as fallback) ----
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
LLM_PRIMARY=gemini

# ---- Evidence search ----
TAVILY_API_KEY=
FACTCHECK_API_KEY=

# ---- WhatsApp (Meta Cloud API) ----
# Only needed by the person who runs the WhatsApp bot.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=claimlens123

# ---- Twilio (main.py creates the client at startup, so put any values here) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
PUBLIC_URL=
VALIDATE_TWILIO=0

# ---- Behaviour ----
SHOW_ENGLISH=0
